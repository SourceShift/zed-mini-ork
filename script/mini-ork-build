#!/usr/bin/env bash
# Build the mini-ork IDE without taking over the machine.
#
#   script/mini-ork-build            # the usual: rebuild after a change
#
# - macOS utility QoS (`taskpolicy -c utility`): the build yields to your apps
#   (background QoS starved even a one-crate rebuild for 11 minutes).
# - MINI_ORK_BUILD_JOBS parallel jobs (default 4): peak RAM grows with every
#   rustc running at once, so fewer jobs is the main memory lever.
# - MINI_ORK_BUILD_DEBUG=false drops debug info: rustc and the linker need far
#   less memory and the binary is a fraction of the size. Changing it rebuilds
#   everything, so it is used for from-scratch builds (upgrades), not for the
#   everyday rebuild (default: the profile's own setting).
# After the first build, an edit to crates/mini_ork_ui rebuilds that crate and
# relinks Zed — about a minute.
set -euo pipefail
cd "$(dirname "$0")/.."
jobs="${MINI_ORK_BUILD_JOBS:-4}"
exec taskpolicy -c utility env \
  ZED_RELEASE_CHANNEL=dev \
  ${MINI_ORK_BUILD_DEBUG:+CARGO_PROFILE_RELEASE_FAST_DEBUG=$MINI_ORK_BUILD_DEBUG} \
  cargo build -p zed --profile release-fast -j "$jobs" "$@"
